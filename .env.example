# Copy to .env and fill in what you have. Everything is optional — Lapis degrades
# gracefully (no key -> heuristics only; no source creds -> that collector is limited).
# NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Acquisition ---------------------------------------------------------
LAPIS_ACTIVE=0                 # 1 = allow read-only live polling of public APIs/feeds
LAPIS_RATE_PER_HOST=1.0        # requests/second/host (be polite)
# LAPIS_UA="LapisResearch/0.1 (agent-coordination study; contact you@example.com)"

# --- Stage-2 classifier (Claude) -----------------------------------------
ANTHROPIC_API_KEY=             # unset -> stage-1 heuristics only
# LAPIS_MODEL=claude-opus-5    # override the confirm model

# --- Per-source credentials / targets ------------------------------------
GITHUB_TOKEN=                  # higher gists rate limit
ETH_RPC_URL=                   # any Ethereum JSON-RPC endpoint (calldata scan)
ETHERSCAN_API_KEY=             # optional, for indexer queries

# Common Crawl (passive)
# LAPIS_CC_CRAWL=CC-MAIN-2026-33
# LAPIS_CC_PATTERNS=*.wikiservice.at/*,prowiki.org/*

# Targeted collectors need locators (no global listing):
# LAPIS_WIKIS=https://example.org/w/api.php        # MediaWiki api.php endpoints (csv)
# LAPIS_NTFY_TOPICS=topic1,topic2                  # ntfy.sh topics to poll (csv)
# LAPIS_JSONBINS=https://api.jsonbin.io/v3/b/XXXX  # full bin URLs (csv)
# LAPIS_IPFS_CIDS=Qm...,bafy...                    # known IPFS CIDs (csv)
